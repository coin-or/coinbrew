function make_doxygen_info {
    echo "## Doxygen Documentation

If you have \`Doxygen\` available, you can build a HTML documentation by typing

\`make doxygen-docs\` 

in the build directory. If $Description_ShortName was built via \`coinbrew\`, then the build
directory will be \`./build/$Coinbrew_ShortName/$version_num\` by default. The doxygen documentation main file
is found at \`<build-dir>/doxydoc/html/index.html\`.
"
    # Doxygen_URL is set by projects whose documentation is published online
    if [ x"${Doxygen_URL-}" != x ]; then
        echo "If you don't have \`doxygen\` installed locally, you can also find the
documentation [here]($Doxygen_URL).
"
    fi
}

#########################################################################
#########################################################################

function make_links {
    echo "
## Project Links

 * [Code of Conduct](https://www.coin-or.org/code-of-conduct/)
 * [COIN-OR Web Site](http://www.coin-or.org/)
 * [COIN-OR general discussion forum](https://github.com/orgs/coin-or/discussions)
 * [$Description_ShortName Discussion forum](https://github.com/coin-or/$Description_Slug/discussions)
 * [Report a bug](https://github.com/coin-or/$Description_Slug/issues/new)"
    if [ x"${Doxygen_URL-}" != x ]; then
        echo " * [Doxygen generated documentation]($Doxygen_URL)"
    fi
    echo
}




